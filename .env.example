# For local preview only. Do NOT enable demo mode in production.
APP_ENV=development
DEMO_MODE=true
DATABASE_URL=sqlite:///./data/ace.db
SESSION_SECRET=replace-with-a-unique-random-64-character-secret
ADMIN_USERNAME=owner
ADMIN_PASSWORD=replace-with-a-long-unique-password
# The URL at which users access the site (used for admin CSRF protection)
SITE_ORIGIN=http://127.0.0.1:8000
# Enter test keys first; use live keys only after business approval and testing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Pending checkout reservations last 30 minutes by default.
RESERVATION_MINUTES=30
# Illustrative defaults: explicitly approve shipping charges before launch.
SHIPPING_FEE_PAISE=0
FREE_SHIPPING_ABOVE_PAISE=0
